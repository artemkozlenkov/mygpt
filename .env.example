# ─── myGPT Configuration ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# Both LiteLLM and OpenWebUI read from this single file.
# The OpenWebUI service overrides DATABASE_URL in compose.yml with its own
# database name — no action needed on your part.

# ─── LiteLLM: Database ────────────────────────────────────────────────────────

# LiteLLM connects to the "litellm" database; OpenWebUI uses the "openwebui"
# database (the latter is injected via ${OPENWEBUI_DATABASE_URL} in compose.yml).
DATABASE_URL=postgres://llmproxy:dbpassword9090@db:5432/litellm
OPENWEBUI_DATABASE_URL=postgresql://llmproxy:dbpassword9090@db:5432/openwebui

# ─── LiteLLM: Core Settings ──────────────────────────────────────────────────

STORE_MODEL_IN_DB="True"
LITELLM_MASTER_KEY="sk-change-me-litellm-master-key"
LITELLM_LOG="INFO"

# ─── Redis (non-TLS — no SSL configured on the Redis container) ──────────────

REDIS_SSL="False"
REDIS_URL="redis://redis:6379/0"

# ─── LLM Provider API Keys ────────────────────────────────────────────────────
# Replace these with your actual API keys before starting the stack.

# Azure AI Foundry (endpoint https://<project>.<region>.services.ai.azure.com)
# AZURE_AI_API_BASE e.g. https://foundry-ai.<region>.services.ai.azure.com
# AZURE_API_VERSION e.g. 2025-03-01-preview (match what your deployment uses)
AZURE_AI_API_BASE="https://foundry-ai.services.ai.azure.com"
AZURE_AI_API_KEY=""
AZURE_API_VERSION="2024-05-01-preview"

# ─── Caddy DNS-01 (Azure DNS) ─────────────────────────────────────────────
# Service principal with "DNS Zone Contributor" on the softawebit.com zone.
# Caddy uses it to solve the ACME DNS-01 challenge for chat.softawebit.com
# (the host is behind CGNAT, so HTTP-01 is impossible). Create it with:
#   az ad sp create-for-rbac --name mygpt-caddy --role "DNS Zone Contributor" \
#     --scopes "/subscriptions/<SUB>/resourceGroups/<RG>/providers/Microsoft.Network/dnszones/softawebit.com"
AZURE_SUBSCRIPTION_ID=""
AZURE_RESOURCE_GROUP_NAME=""
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Google Gemini
GEMINI_API_KEY=""

# Moonshot / Kimi (via https://api.moonshot.cn/v1)
# Register at https://platform.moonshot.cn to get an API key.
MOONSHOT_API_KEY="sk-mock-moonshot-placeholder-change-me"

# xAI / Grok (via https://api.x.ai/v1)
# Register at https://console.x.ai to get an API key.
XAI_API_BASE="https://api.x.ai/v1"
XAI_API_KEY="sk-mock-xai-placeholder-change-me"

# ─── LiteLLM: Admin Panel ────────────────────────────────────────────────────

UI_USERNAME=""
UI_PASSWORD=""

# ─── Microsoft OAuth / SSO (shared between services) ──────────────────────────
# SSO with Microsoft Entra ID (Azure). Register the app once:
#   portal.azure.com → Microsoft Entra ID → App registrations → New registration
#   - Name: anything (e.g. "mygpt-webui")
#   - Supported account types: "Accounts in this organizational directory only"
#   - Redirect URI → Platform: Web →
#       https://chat.softawebit.com/oauth/microsoft/callback
#     (must EXACTLY match MICROSOFT_REDIRECT_URI below; OpenWebUI handles both
#      /oauth/microsoft/callback and /oauth/microsoft/login/callback)
#   - API permissions → Microsoft Graph → Delegated → User.Read (email, openid,
#     profile are already in the default scope)
#   - Certificates & secrets → New client secret → paste into
#     MICROSOFT_CLIENT_SECRET
# Copy the two values from the app's Overview page:
#   Application (client) ID → MICROSOFT_CLIENT_ID
#   Directory (tenant) ID   → MICROSOFT_CLIENT_TENANT_ID
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_CLIENT_TENANT_ID=""
# Canonical (production) redirect — Caddy terminates TLS and reverse-proxies to
# OpenWebUI, so SSO callbacks arrive over HTTPS here. OpenWebUI is internal-only
# in compose.yml (no host port), so this is the URL you browse. The localhost
# redirect is also registered in Azure; only switch to it if you re-expose
# OpenWebUI on a host port. Caddy sets X-Forwarded-Proto/Host automatically.
MICROSOFT_REDIRECT_URI="https://chat.softawebit.com/oauth/microsoft/callback"

# ─── OpenWebUI: Authentication ────────────────────────────────────────────────

# Master switch — True makes sign-in required (SSO and/or local login).
WEBUI_AUTH=True
# Browser-visible URL of OpenWebUI. Must match how you browse — SSO callbacks
# and post-login redirects depend on it. HTTPS via Caddy is primary; for local
# dev only, temporarily set http://localhost:8000.
WEBUI_URL="https://chat.softawebit.com"
# Show the username/password login form as a fallback next to the SSO button.
ENABLE_LOGIN_FORM=true
# Allow new accounts via the local sign-up form. Creating the very first admin
# is always allowed even when false; SSO sign-ups are governed by
# ENABLE_OAUTH_SIGNUP.
ENABLE_SIGNUP=false
# Allow new accounts to be created when signing in via SSO.
ENABLE_OAUTH_SIGNUP=true
# Optional — the email shown as the admin identity. The FIRST account ever
# created (via SSO or the local form) is auto-promoted to admin; set this to
# your Entra ID email so it is remembered as the admin.
ADMIN_EMAIL="admin@admin.com"
DEFAULT_USER_ROLE="user"
SHOW_ADMIN_DETAILS=false

# ─── OpenWebUI: General ──────────────────────────────────────────────────────

WEBUI_NAME="MY GPT"
GLOBAL_LOG_LEVEL=ERROR

# ─── OpenWebUI: Backend Endpoint (points to local LiteLLM) ───────────────────

OPENAI_API_BASE_URL="http://litellm:4000"
OPENAI_API_KEYS="sk-change-me-litellm-master-key"

# ─── OpenWebUI: Model Configuration ──────────────────────────────────────────

DEFAULT_MODELS=gpt-5.6-luna
ENABLE_OLLAMA_API=False
# Disable the OpenWebUI Model Arena (virtual comparison model in the picker)
ENABLE_EVALUATION_ARENA_MODELS=False

# ─── OpenWebUI: Suggested Prompts ────────────────────────────────────────────

DEFAULT_PROMPT_SUGGESTIONS='[{"title":["Write an email","professional and clear"],"content":"Help me write a professional email. I will tell you the recipient and what I need to communicate."},{"title":["Proofread this text","fix errors and improve flow"],"content":"Proofread my text below. Fix typos, grammar, and punctuation, and improve flow without changing my meaning."},{"title":["Set the tone","formal / friendly / concise"],"content":"Rewrite my text with a formal, friendly, persuasive, or concise tone. Keep the facts, change only the style."},{"title":["Correct grammar","and explain the fixes"],"content":"Correct the grammar in my text below. Explain each mistake, then give me the corrected version."},{"title":["Check the information","verify facts and sources"],"content":"Fact-check the information below. Verify claims, flag anything uncertain or outdated, and provide reliable sources."},{"title":["Web search","find current info"],"content":"Use web search to find current, up-to-date information about my topic. Summarize the key findings with sources."},{"title":["Deep analysis","structured breakdown"],"content":"Give a deep, structured analysis of my topic: key points, pros and cons, evidence, and a clear conclusion."}]'

# ─── OpenWebUI: RAG / Web Search ─────────────────────────────────────────────

ENABLE_WEB_SEARCH=True
ENABLE_SEARCH_QUERY_GENERATION=True
WEB_SEARCH_ENGINE="searxng"
WEB_SEARCH_RESULT_COUNT=3
WEB_SEARCH_CONCURRENT_REQUESTS=10
SEARXNG_QUERY_URL="http://searxng:8080/search?q=<query>"
# SearxNG session-signing key (overrides settings.yml). Generate with: openssl rand -hex 32
SEARXNG_SECRET="change-me-run-openssl-rand-hex-32"

# ─── OpenWebUI: Embeddings ───────────────────────────────────────────────────

RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_MODEL_AUTO_UPDATE=True
RAG_EMBEDDING_ENGINE=openai
PDF_EXTRACT_IMAGES=True
# Embeddings are routed through the LiteLLM proxy (which forwards to the
# Azure deployment "text-embedding-3-large"). Keep the same value as
# LITELLM_MASTER_KEY.
RAG_OPENAI_API_BASE_URL="http://litellm:4000/v1"
RAG_OPENAI_API_KEY="sk-change-me-litellm-master-key"

# ─── OpenWebUI: Speech (optional) ────────────────────────────────────────────

# AUDIO_TTS_ENGINE=azure
# AUDIO_TTS_AZURE_SPEECH_OUTPUT_FORMAT=audio-24khz-160kbitrate-mono-mp3
# AUDIO_TTS_AZURE_SPEECH_REGION=swedencentral
# AUDIO_TTS_VOICE=en-US-AlloyMultilingualNeuralHD
# AUDIO_TTS_API_KEY=""
